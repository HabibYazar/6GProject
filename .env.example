# Copy to .env and fill in the password you gave the 'nsg' Postgres role.
# .env is gitignored; never commit a filled-in copy.
#
# Port 5433 is intentional — see the note in nsg_ai/db.py.
NSG_DATABASE_URL=postgresql+psycopg://nsg:PAROLA@127.0.0.1:5433/nsg

# ── Authentication (local, see nsg_ai/auth.py) ───────────────────────────────
# Identities live in this same Postgres; nothing leaves the machine. The token
# is signed with this secret (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NSG_AUTH_SECRET=CHANGE_ME

# Enforcement is OFF by default so the dev box and QA tools work unchanged. Set
# to 1 to require a login on every data and mutation route. With it on, a secret
# above is mandatory.
NSG_AUTH_REQUIRED=0

# Browser origins allowed to call the API (comma-separated). Defaults to the
# local dev frontend. Replace "*" was never valid together with credentials.
NSG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Docker Compose deployment (docker-compose.yml) ───────────────────────────
# Only needed when running the stack with compose; the dev box ignores these.
#
# The compose database is created with this password, and NSG_DATABASE_URL above
# is IGNORED in that mode — the backend service builds its own URL pointing at
# the `db` service. Keep the two in sync only if you also run tools against the
# published 127.0.0.1:5433.
NSG_DB_PASSWORD=CHANGE_ME

# The finished engine image. Built by engines/nsoran/build-slim.sh, never by
# compose; see the note at the top of docker-compose.yml for moving it between
# Docker daemons on the WSL development box.
NSG_ENGINE_IMAGE=nsg-engine:1.8

# Live-bridge address of every engine instance, comma separated. ONE run per
# instance — adding entries is how a campaign gets more throughput. With the
# `pool` profile up:
#   NSG_ENGINE_POOL=engine:8091,engine2:8091,engine3:8091
NSG_ENGINE_POOL=engine:8091

# What the BROWSER should call the API. Baked into the frontend bundle at build
# time, so changing it needs `docker compose build frontend`.
NSG_PUBLIC_API_URL=http://localhost:8000

# The OpenRouter key is read from nsg_ai/.env by the backend service (env_file),
# so it does NOT need to be repeated here.
