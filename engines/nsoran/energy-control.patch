# Pairs with engines/nsoran/xapp_kpm_rc.c (nsg_gen_energy_ctrl_msg sets the
# action id to power+1; the gNB subtracts 1). Apply to:
#   src/mmwave/model/mmwave-enb-net-device.cc  (ControlMessageReceivedCallback,
#   the RicControlMessage::ControlMessageServiceStyle::Energy_state case)

