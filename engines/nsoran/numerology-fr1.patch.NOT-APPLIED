# ============================================================================
# NOT APPLIED. Deliberately parked 2026-09-15, to be revisited after the demo.
# The engine, the host ns-3 tree and image 1.24 are all back to the shipped
# state (verified by md5). Nothing in the build references this file.
# ============================================================================
#
# WHAT IT DOES
# Unlocks NR numerology 0 and 1 (FR1) in the mmWave engine, which currently
# supports only 2 and 3 (FR2). `MmWavePhyMacCommon::SetNrNumerology` is already
# fully general -- `15 * 2^index`, `m_slotsPerSubframe = 2^index`,
# `m_symbolPeriod = 1ms / 14 / 2^index`. Only checkers and one assert block it.
#
# WHY IT IS INTERESTING
# 1. CORRECTNESS: our scenarios run at 3.5-3.6 GHz, which is FR1. TS 38.101-1
#    gives mu 0 (15 kHz) and mu 1 (30 kHz) there, and a real 3.6 GHz NR cell
#    uses mu 1. We have been simulating FR1 with an FR2 numerology.
# 2. SPEED: the slot is 1 ms / 2^mu, so mu2 -> mu1 halves the TTI count.
#
# WHAT WAS MEASURED (3 cells / 6 UEs @ 3.6 GHz / 50 MHz, 120 s window,
# ok-status runs only -- truncated/crashed runs excluded):
#
#            span_s            throughput Mbps      PRB
#   mu=2   4.05 (3.9, 4.2)     9.25 (8.7, 9.8)     9.55
#   mu=1   5.45 (5.1, 5.8)     8.70 (6.7, 10.7)    7.80
#   mu=0   aborts immediately, 3/3 seeds
#
#   speed : 1.35x, and the span ranges are DISJOINT -> the result is real.
#   fidelity: NOT ESTABLISHED. n=2 per arm and mu1's own throughput spread
#             (6.7 -> 10.7) is larger than the difference between the arms.
#             The honest statement is "no change was demonstrated", NOT
#             "no change occurred". Needs 5+ seeds before anyone ships it.
#
# WHY mu=0 CANNOT BE USED AS-IS
#   NS_ASSERT failed, cond="(m_currSlotAllocInfo.m_sfnSf.m_frameNum == m_frameNum)
#   && (m_currSlotAllocInfo.m_sfnSf.m_sfNum == m_sfNum)
#   && (m_currSlotAllocInfo.m_sfnSf.m_slotNum == m_slotNum)"
#   at src/mmwave/model/mmwave-enb-phy.cc:966, at t=+0.001s.
# The scheduler's slot allocation book and the PHY's frame/subframe/slot
# counters disagree at mu0. Solvable, but it is its own piece of work.
#
# THE TRAP THIS PATCH EXISTS TO RECORD: THREE clamps, and reading the source
# found only two of them.
#   1. the C++ enum + MakeEnumChecker + NS_ASSERT   (mmwave-phy-mac-common)
#   2. the scenario's `nsgNum.Get() == 3 ? mu3 : mu2` ternary
#   3. the scenario's OWN GlobalValue: MakeUintegerChecker<uint32_t>(2, 3)
# Number 3 surfaced only when a run came back no_data and the sim log said
# `Invalid command-line argument: --nsgNumerology=1`. ns-3 rejected the value
# at argument-parse time, before any patched code ran.
# Also note: `--PrintHelp` is NOT a way to test whether an argument is accepted;
# ns-3 handles help in an earlier pass and skips validation. Check the binary's
# md5, or read a real run's log.
#
# IF PICKED UP: the platform clamp in nsg_ai/main.py (`_clamp(..., 2, 3)`) must
# widen to (1, 3) -- NOT (0, 3), because mu0 aborts. And the engine reaches the
# product only through build-slim.sh, never through a host rebuild
# (nsg-engine-image-deploy).
#
# ----------------------------------------------------------------------------
# ns-O-RAN mmWave: unlock numerology 0 and 1 (FR1).
#
# `MmWavePhyMacCommon::SetNrNumerology` is already fully general --
# `subcarrierSpacing = 15 * 2^index * 1000`, `m_slotsPerSubframe = 2^index`,
# `m_symbolPeriod = 1ms / 14 / 2^index`. Only an enum with two members, a
# MakeEnumChecker with two entries, and one NS_ASSERT restrict it to 2 and 3.
#
# The upstream justification is "Only 2 and 3 are supported in NR for FR2" --
# and that is correct FOR FR2 (24-52 GHz). Our scenarios run at 3.5 GHz, which
# is FR1, where TS 38.101-1 gives mu 0 (15 kHz) and mu 1 (30 kHz) and a real
# 3.5 GHz NR cell uses mu 1. So the engine has been running a numerology that
# does not match the band it simulates.
#
# Why it matters for SPEED: the slot is 1ms / 2^mu, so mu2 -> mu1 halves the
# number of TTIs per simulated second and mu2 -> mu0 quarters it. The inclusive
# profile is dominated by per-TTI-per-link work (StartTti 21.7%, spectrum
# StartTx+StartRx ~26%, ConfigureBeamforming 25%), while the one per-RB item
# (GenSpectrumChannelMatrix) is ~1%. RB count rises 4x at mu0 (rbWidth = 12 x
# SCS, so 20 MHz gives 111 RBs instead of 27), but that lands on the ~1% term.
#
# UNMEASURED AT THE TIME OF WRITING -- this patch exists to be measured.
--- a/src/mmwave/model/mmwave-phy-mac-common.h
+++ b/src/mmwave/model/mmwave-phy-mac-common.h
@@
     enum Numerology
     {
+        NrNumerology0 = 0, //!< NR numerology index 0 (15 kHz, FR1)
+        NrNumerology1 = 1, //!< NR numerology index 1 (30 kHz, FR1)
         NrNumerology2 = 2, //!< NR numerology index 2
         NrNumerology3 = 3  //!< NR numerology index 3
     };
--- a/src/mmwave/model/mmwave-phy-mac-common.cc
+++ b/src/mmwave/model/mmwave-phy-mac-common.cc
@@
-                MakeEnumChecker(NrNumerology2, "NrNumerology2", NrNumerology3, "NrNumerology3"))
+                MakeEnumChecker(NrNumerology0, "NrNumerology0",
+                                NrNumerology1, "NrNumerology1",
+                                NrNumerology2, "NrNumerology2",
+                                NrNumerology3, "NrNumerology3"))
@@
-    if (num == Numerology::NrNumerology2)
-        SetNrNumerology(2);
-    else if (num == Numerology::NrNumerology3)
-        SetNrNumerology(3);
-    else
+    if (num == Numerology::NrNumerology0)
+        SetNrNumerology(0);
+    else if (num == Numerology::NrNumerology1)
+        SetNrNumerology(1);
+    else if (num == Numerology::NrNumerology2)
+        SetNrNumerology(2);
+    else if (num == Numerology::NrNumerology3)
+        SetNrNumerology(3);
+    else
@@
-    NS_ASSERT_MSG((index == 2) || (index == 3),
-                  "Numerology index is not valid."); // Only 2 and 3 are supported in NR for FR2.
+    NS_ASSERT_MSG(index <= 3,
+                  "Numerology index is not valid."); // 0-1 are FR1, 2-3 are FR2.
--- a/scratch/scenario-zero-with_parallel_loging.cc
+++ b/scratch/scenario-zero-with_parallel_loging.cc
@@
-        Config::SetDefault("ns3::MmWavePhyMacCommon::Numerology",
-                           StringValue (nsgNum.Get () == 3 ? "NrNumerology3" : "NrNumerology2"));
+        // NSG: mu 0/1 are FR1 (15/30 kHz) and 3.5-3.6 GHz IS FR1. Without this
+        // the scenario silently collapsed every value except 3 down to 2, so
+        // widening the C++ enum alone would have changed nothing.
+        {
+            uint32_t mu = nsgNum.Get ();
+            if (mu > 3) mu = 3;
+            Config::SetDefault ("ns3::MmWavePhyMacCommon::Numerology",
+                                StringValue ("NrNumerology" + std::to_string (mu)));
+        }
