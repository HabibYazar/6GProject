+// NSG Level-2: exact node positions from the platform config. Passed as FILE
+// paths (shell-safe) whose contents are ";"-separated "x,y" pairs in scenario
+// coords. Empty path => fall back to the auto ring/disc layout (original).
+static ns3::GlobalValue gnb_positions_file ("gnbPositionsFile", "File of ';'-sep 'x,y' gNB positions; empty=auto ring",
+                                            ns3::StringValue (""),
+                                            ns3::MakeStringChecker ());
+static ns3::GlobalValue ue_positions_file ("uePositionsFile", "File of ';'-sep 'x,y' UE positions; empty=auto disc",
+                                           ns3::StringValue (""),
+                                           ns3::MakeStringChecker ());
+// NSG consistency: fixed RNG run => the same config reproduces the same run.
+static ns3::GlobalValue rng_run ("rngRun", "ns-3 RNG run number (fixed => reproducible)",
+                                 ns3::UintegerValue (1),
+                                 ns3::MakeUintegerChecker<uint32_t> ());
+
+// Read a whole file into a string ("" if it can't be opened / path empty).
+static std::string NsgReadFile (const std::string &fname) {
+    if (fname.empty ()) return "";
+    std::ifstream f (fname.c_str ());
+    if (!f.is_open ()) return "";
+    std::stringstream ss; ss << f.rdbuf ();
+    return ss.str ();
+}
+
+// Parse ";"-separated "x,y" pairs into ns3::Vector (z=3). Tolerant of blanks.
+static std::vector<ns3::Vector> NsgParsePositions (const std::string &s) {
+    std::vector<ns3::Vector> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        size_t a = item.find_first_not_of (" \t\r\n");
+        if (a == std::string::npos) continue;
+        size_t b = item.find_last_not_of (" \t\r\n");
+        item = item.substr (a, b - a + 1);
+        size_t comma = item.find (',');
+        if (comma == std::string::npos) continue;
+        try {
+            double x = std::stod (item.substr (0, comma));
+            double y = std::stod (item.substr (comma + 1));
+            out.emplace_back (x, y, 3);
+        } catch (...) { }
+    }
+    return out;
+}
