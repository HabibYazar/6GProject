+// Parse ";"-separated doubles (per-gNB TX power in dBm). Tolerant of blanks.
+static std::vector<double> NsgParseDoubles (const std::string &s) {
+    std::vector<double> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        size_t a = item.find_first_not_of (" \t\r\n");
+        if (a == std::string::npos) continue;
+        try { out.push_back (std::stod (item.substr (a))); } catch (...) { }
+    }
+    return out;
+}
