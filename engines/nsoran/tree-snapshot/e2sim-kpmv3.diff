diff --git a/e2sim/src/DEF/e2sim_defs.h b/e2sim/src/DEF/e2sim_defs.h
index cf6cb8b..21d2195 100644
--- a/e2sim/src/DEF/e2sim_defs.h
+++ b/e2sim/src/DEF/e2sim_defs.h
@@ -29,7 +29,11 @@
 #define X2AP_PPID           (452984832) //27 = 1b, PPID = 1b000000(hex) -> 452984832(dec)
 #define X2AP_SCTP_PORT      36421
 #define RIC_SCTP_SRC_PORT   38472
-#define MAX_SCTP_BUFFER     10000
+// NSG: was 10000. A KPM indication grows with the UEs reported (measured
+// 8447 bytes at 10 UEs on one cell), so 15 UEs/cell produced a PDU larger
+// than this buffer. sctp_buffer_t is a stack local in several places, so
+// keep it well inside a thread stack while leaving real headroom.
+#define MAX_SCTP_BUFFER     65536
 #define WORKDIR_ENV         "E2SIM_DIR" //environment variable
 
 
diff --git a/e2sim/src/base/e2sim.cpp b/e2sim/src/base/e2sim.cpp
index 853d845..4f68af8 100644
--- a/e2sim/src/base/e2sim.cpp
+++ b/e2sim/src/base/e2sim.cpp
@@ -104,7 +104,16 @@ void E2Sim::encode_and_send_sctp_data(E2AP_PDU_t* pdu)
   sctp_buffer_t data;
 
   data.len = e2ap_asn1c_encode_pdu(pdu, &buf);
-  memcpy(data.buffer, buf, min(data.len, MAX_SCTP_BUFFER));
+  // NSG: the copy was clamped but data.len was not, and sctp_send_data() sends
+  // data.len bytes out of this fixed buffer -- so an oversized PDU was read
+  // past the end of the struct and shipped to the RIC, which then dropped the
+  // association. Clamp the LENGTH too: truncating is wrong but bounded, and it
+  // says so, instead of corrupting memory silently.
+  if (data.len > MAX_SCTP_BUFFER) {
+    LOG_E("[SCTP] PDU of %d bytes exceeds MAX_SCTP_BUFFER (%d) - truncating", data.len, MAX_SCTP_BUFFER);
+    data.len = MAX_SCTP_BUFFER;
+  }
+  memcpy(data.buffer, buf, data.len);
 
   LOG_I("Send data to client_fd %d", client_fd)
   sctp_send_data(client_fd, data);
diff --git a/e2sim/src/encoding/encode_e2apv1.cpp b/e2sim/src/encoding/encode_e2apv1.cpp
index 27c69f2..02d7350 100644
--- a/e2sim/src/encoding/encode_e2apv1.cpp
+++ b/e2sim/src/encoding/encode_e2apv1.cpp
@@ -818,7 +818,15 @@ void encoding::generate_e2apv1_indication_request_parameterized(E2AP_PDU *e2ap_p
     ricind_ies6->value.choice.RICindicationHeader.size = header_length;
     memcpy(ricind_ies6->value.choice.RICindicationHeader.buf, ind_header_buf, header_length);
 
-    ricind_ies7->value.choice.RICindicationMessage.buf = (uint8_t *) calloc(1, 8192);
+    // NSG: was calloc(1, 8192) while the memcpy below copies message_length
+    // bytes. The KPM indication grows with the number of UEs reported, so at
+    // roughly ten UEs on one cell message_length passes 8192 (measured 8447)
+    // and the copy runs off the end of the heap block. glibc does not notice
+    // at the memcpy; it aborts at the NEXT allocation, the 144-byte
+    // InitiatingMessage_t below, with "malloc(): invalid size (unsorted)" --
+    // which is why this looked like a mysterious density limit for so long.
+    // Size it like the header buffers above already do.
+    ricind_ies7->value.choice.RICindicationMessage.buf = (uint8_t *) calloc(1, message_length);
 
     ricind_ies7->id = ProtocolIE_ID_id_RICindicationMessage;
 
