+// Read a whole file into a string ("" if it can't be opened / path empty).
+static std::string NsgReadFile (const std::string &fname) {
+    if (fname.empty ()) return "";
+    std::ifstream f (fname.c_str ());
+    if (!f.is_open ()) return "";
+    std::stringstream ss; ss << f.rdbuf ();
+    return ss.str ();
+}
