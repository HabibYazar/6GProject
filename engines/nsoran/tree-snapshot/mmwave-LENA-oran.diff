+// Parse ";"-separated "x,y" pairs into ns3::Vector (z=3). Tolerant of blanks.
+static std::vector<ns3::Vector> NsgParsePositions (const std::string &s) {
+    std::vector<ns3::Vector> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        size_t a = item.find_first_not_of (" \t\r\n");
+        if (a == std::string::npos) continue;
+        size_t b = item.find_last_not_of (" \t\r\n");
+        item = item.substr (a, b - a + 1);
+        size_t comma = item.find (',');
+        if (comma == std::string::npos) continue;
+        try {
+            double x = std::stod (item.substr (0, comma));
+            std::string rest = item.substr (comma + 1);
+            // NSG: optional third field = height. Both base_stations[].position.z
+            // and the UE height were inert because this parser hardcoded 3 m for
+            // everything — a 25 m macro mast and a 1.5 m handset were the same
+            // height to the channel model. Two-field records keep the old 3 m.
+            double y = 0.0, z = 3.0;
+            size_t comma2 = rest.find (',');
+            if (comma2 == std::string::npos) {
+                y = std::stod (rest);
+            } else {
+                y = std::stod (rest.substr (0, comma2));
+                z = std::stod (rest.substr (comma2 + 1));
+                if (!std::isfinite (z)) z = 3.0;
+                z = std::max (0.5, std::min (150.0, z));
+            }
+            out.emplace_back (x, y, z);
+        } catch (...) { }
+    }
+    return out;
+}
+
+// NSG Level-4: build the config's buildings. Each ";"-separated record is
+// "xmin,xmax,ymin,ymax,zmin,zmax,wall" (wall 0=wood 1=concrete-with-windows
+// 2=concrete). Returns how many were created — >0 flips the channel condition
+// model to the buildings-aware one, so obstacles really shadow the RAN.
+static int NsgCreateBuildings (const std::string &s) {
+    int n = 0;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        if (item.find_first_not_of (" \t\r\n") == std::string::npos) continue;
+        std::stringstream is (item);
+        std::string f;
+        std::vector<double> v;
+        while (std::getline (is, f, ',')) {
+            try { v.push_back (std::stod (f)); } catch (...) { }
+        }
+        if (v.size () < 6) continue;
+        ns3::Ptr<ns3::Building> b = ns3::CreateObject<ns3::Building> ();
+        b->SetBoundaries (ns3::Box (v[0], v[1], v[2], v[3], v[4], v[5]));
+        int wall = (v.size () > 6) ? (int) v[6] : 2;
+        b->SetExtWallsType (wall == 0 ? ns3::Building::Wood
+                            : wall == 1 ? ns3::Building::ConcreteWithWindows
+                                        : ns3::Building::ConcreteWithoutWindows);
+        // NSG: type / floors / rooms from the config. These were hardcoded
+        // Office/1/1/1, which made four schema fields inert — ns-3 uses the
+        // room and floor counts to compute how many internal walls a path
+        // crosses, so they are real propagation inputs, not labels. Records
+        // written before this carry only 7 fields and keep the old defaults.
+        int nsgType   = v.size () >= 8  ? (int) v[7]  : 1;
+        int nsgFloors = v.size () >= 9  ? (int) v[8]  : 1;
+        int nsgRoomsX = v.size () >= 10 ? (int) v[9]  : 1;
+        int nsgRoomsY = v.size () >= 11 ? (int) v[10] : 1;
+        b->SetBuildingType (nsgType == 0 ? ns3::Building::Residential
+                            : nsgType == 2 ? ns3::Building::Commercial
+                                           : ns3::Building::Office);
+        b->SetNFloors ((uint16_t) std::max (1, std::min (30, nsgFloors)));
+        b->SetNRoomsX ((uint16_t) std::max (1, std::min (20, nsgRoomsX)));
+        b->SetNRoomsY ((uint16_t) std::max (1, std::min (20, nsgRoomsY)));
+        ++n;
+    }
+    return n;
+}
+
+// Parse ";"-separated doubles (per-gNB TX power in dBm). Tolerant of blanks.
+static std::vector<double> NsgParseDoubles (const std::string &s) {
+    std::vector<double> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        size_t a = item.find_first_not_of (" \t\r\n");
+        if (a == std::string::npos) continue;
+        try { out.push_back (std::stod (item.substr (a))); } catch (...) { }
+    }
+    return out;
+}
+
+// NSG Phase 2c: one antenna panel — orientation already converted to the ns-3
+// convention (radians), plus the array size.
+struct NsgAntenna { double bearingRad; double downtiltRad; uint32_t rows; uint32_t cols;
+                    double polSlantRad; double hSpacing; double vSpacing;
+                    // Element beamwidth, only read by the elements that HAVE
+                    // one (cosine, parabolic). The 3GPP element's pattern is
+                    // fixed by TR 38.901 and isotropic has no direction, so for
+                    // those two these are correctly ignored rather than
+                    // silently applied to nothing.
+                    double hBeamwidthDeg; double vBeamwidthDeg; double maxGainDb; };
+
+// Parse ';'-sep per-gNB 'azimuth_deg,tilt_deg,rows,cols'. Azimuth arrives in the
+// config's compass convention (0 = North, clockwise) and is converted here to
+// ns-3's phi (0 = +x/East, counter-clockwise), wrapped into (-pi, pi] because
+// UniformPlanarArray's BearingAngle checker rejects anything outside it.
+// A malformed record falls back to the engine's own default panel rather than
+// dropping the gNB, so the spec stays index-aligned with gnbPositionsFile.
+static std::vector<NsgAntenna> NsgParseAntennas (const std::string &s) {
+    std::vector<NsgAntenna> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        if (item.find_first_not_of (" \t\r\n") == std::string::npos) continue;
+        std::stringstream is (item);
+        std::string f;
+        std::vector<double> v;
+        while (std::getline (is, f, ',')) {
+            try { v.push_back (std::stod (f)); } catch (...) { v.push_back (std::nan ("")); }
+        }
+        NsgAntenna a {0.0, 0.0, 8, 8, 0.0, 0.5, 0.5, 65.0, 65.0, 8.0};
+        if (v.size () >= 1 && std::isfinite (v[0])) {
+            double phiDeg = 90.0 - v[0];                    // compass -> ns-3 phi
+            while (phiDeg <= -180.0) phiDeg += 360.0;
+            while (phiDeg > 180.0) phiDeg -= 360.0;
+            a.bearingRad = phiDeg * M_PI / 180.0;
+        }
+        if (v.size () >= 2 && std::isfinite (v[1]))
+            a.downtiltRad = std::max (-90.0, std::min (90.0, v[1])) * M_PI / 180.0;
+        if (v.size () >= 3 && std::isfinite (v[2]))
+            a.rows = (uint32_t) std::max (1.0, std::min (16.0, v[2]));
+        if (v.size () >= 4 && std::isfinite (v[3]))
+            a.cols = (uint32_t) std::max (1.0, std::min (16.0, v[3]));
+        // 5th field: polarisation slant (deg) -> UniformPlanarArray::PolSlantAngle.
+        // Older 4-field records keep 0.
+        if (v.size () >= 5 && std::isfinite (v[4]))
+            a.polSlantRad = std::max (-90.0, std::min (90.0, v[4])) * M_PI / 180.0;
+        // 6th/7th: element spacing in wavelengths. Tighter than 0.5 couples the
+        // elements and broadens the beam; wider sharpens it and raises grating
+        // lobes. Older records keep the 3GPP-typical 0.5.
+        if (v.size () >= 6 && std::isfinite (v[5]))
+            a.hSpacing = std::max (0.1, std::min (4.0, v[5]));
+        // 8th/9th/10th: element beamwidth (deg) and boresight gain (dB), for
+        // the cosine and parabolic elements. 65 deg is the 3GPP-typical sector
+        // pattern, so an older record keeps roughly the behaviour it had.
+        // Parabolic reads the horizontal figure only — it has one beamwidth.
+        if (v.size () >= 8 && std::isfinite (v[7]))
+            a.hBeamwidthDeg = std::max (1.0, std::min (360.0, v[7]));
+        if (v.size () >= 9 && std::isfinite (v[8]))
+            a.vBeamwidthDeg = std::max (1.0, std::min (360.0, v[8]));
+        if (v.size () >= 10 && std::isfinite (v[9]))
+            a.maxGainDb = std::max (-30.0, std::min (60.0, v[9]));
+        out.push_back (a);
+    }
+    return out;
+}
+
+// NSG Phase 2b: parse the per-UE waypoint spec. Outer ';' = one slot per UE
+// (aligned with uePositionsFile), inner '|' = the ordered waypoints of that
+// UE, each 'x,y,z,t' with t the ARRIVAL time in seconds. An empty slot means
+// "this UE has no path" and is returned as an empty vector, so the caller can
+// leave it on the random walk. Times are forced monotonic (ns-3's
+// WaypointMobilityModel aborts on a non-increasing waypoint time), and a
+// malformed field drops just that waypoint.
+static std::vector<std::vector<ns3::Waypoint> > NsgParseWaypoints (const std::string &s) {
+    std::vector<std::vector<ns3::Waypoint> > out;
+    std::stringstream ss (s);
+    std::string slot;
+    while (std::getline (ss, slot, ';')) {
+        std::vector<ns3::Waypoint> path;
+        double lastT = -1.0;
+        std::stringstream ps (slot);
+        std::string wp;
+        while (std::getline (ps, wp, '|')) {
+            if (wp.find_first_not_of (" \t\r\n") == std::string::npos) continue;
+            std::stringstream fs (wp);
+            std::string f;
+            std::vector<double> v;
+            while (std::getline (fs, f, ',')) {
+                try { v.push_back (std::stod (f)); } catch (...) { v.push_back (std::nan ("")); }
+            }
+            if (v.size () < 4) continue;
+            bool bad = false;
+            for (size_t i = 0; i < 4; ++i) if (!std::isfinite (v[i])) bad = true;
+            if (bad) continue;
+            if (v[3] <= lastT) v[3] = lastT + 1e-3;   // strictly increasing
+            lastT = v[3];
+            path.push_back (ns3::Waypoint (ns3::Seconds (v[3]), ns3::Vector (v[0], v[1], v[2])));
+        }
+        out.push_back (path);
+    }
+    return out;
+}
+
+// ---------------------------------------------------------------------------
+// NSG Phase 2a — RU sleep states.
+//
+// A cell used to have exactly two energy states: serving (idle draw or higher)
+// and switched OFF (0 A, only reachable by the config / an E2 power=0 control).
+// A real RU lives in between: with nothing to serve it descends into a sleep
+// depth — micro, light, deep — each drawing less and each costing a longer
+// wake-up latency before it can carry traffic again. This is that state
+// machine: per gNB, driven by measured activity, with the depth charged to the
+// ns-3 radio energy model and the wake-up delay really keeping the cell off
+// the air (TX power 0 + raised noise figure, the same way the E2 energy-state
+// control puts a cell down).
+// ---------------------------------------------------------------------------
+struct NsgSleepCfg {
+    int depth = 0;         // 0=disabled, 1=micro, 2=light, 3=deep
+    double idleMs = 200.0; // shutdown timer: how long idle before descending
+    double wakeMs = 10.0;  // wake-up latency before the cell serves again
+};
+
+struct NsgSleepCell {
+    Ptr<MmWaveEnbNetDevice> dev;
+    Ptr<MmWaveRadioEnergyModelEnb> model;
+    NsgSleepCfg cfg;
+    double cfgPowerDbm = 30.0; // the power to restore on wake
+    uint16_t cellId = 0;
+    bool asleep = false;
+    bool waking = false;
+    double idleSinceS = -1.0;
+    double lastTxT = 0.0;
+    double duty = 0.0; // share of the last tick spent transmitting
+    size_t ues = 0;
+    int sleeps = 0;
+    int wakes = 0;
+    double sleepStartS = 0.0;
+    double sleepTotalS = 0.0;
+    double awakeUntilS = -1.0; // anti-ping-pong hold-down after a wake
+};
+
+static std::vector<NsgSleepCell> g_nsgSleepCells;
+static double g_nsgSleepTickS = 0.02;
+static double g_nsgWakeLoadPct = 60.0;
+static double g_nsgIdleDutyPct = 0.0;
+static double g_nsgWakeHoldS = 0.5;
+
+static const char *
+NsgSleepName (int d) {
+    return d == 1 ? "micro" : d == 2 ? "light" : d == 3 ? "deep" : "none";
+}
+
+// Parse ";"-separated "depth,idle_ms,wake_ms" records. A record may carry just
+// the depth (defaults for the timers), which keeps the UI's simple case simple.
+static std::vector<NsgSleepCfg> NsgParseSleepCfgs (const std::string &s) {
+    std::vector<NsgSleepCfg> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        if (item.find_first_not_of (" \t\r\n") == std::string::npos) continue;
+        std::stringstream is (item);
+        std::string f;
+        std::vector<double> v;
+        while (std::getline (is, f, ',')) {
+            try { v.push_back (std::stod (f)); } catch (...) { }
+        }
+        if (v.empty ()) continue;
+        NsgSleepCfg c;
+        c.depth = (int) v[0];
+        if (c.depth < 0) c.depth = 0;
+        if (c.depth > 3) c.depth = 3;
+        if (v.size () > 1 && v[1] > 0) c.idleMs = v[1];
+        if (v.size () > 2 && v[2] >= 0) c.wakeMs = v[2];
+        out.push_back (c);
+    }
+    return out;
+}
+
+// Wake-up completed: the radio is warm again, so restore the configured power.
+static void NsgSleepWakeDone (size_t i) {
+    if (i >= g_nsgSleepCells.size ()) return;
+    NsgSleepCell &c = g_nsgSleepCells[i];
+    if (!c.waking) return;
+    double now = Simulator::Now ().GetSeconds ();
+    c.dev->GetPhy ()->SetTxPower (c.cfgPowerDbm);
+    c.dev->GetPhy ()->SetNoiseFigure (5);
+    c.dev->SetSleepStateCode (4);
+    c.sleepTotalS += now - c.sleepStartS;
+    c.asleep = false;
+    c.waking = false;
+    c.idleSinceS = -1.0;
+    c.awakeUntilS = now + g_nsgWakeHoldS;
+    c.wakes++;
+    NS_LOG_UNCOND ("[NSG-SLEEP] t=" << now << " cell=" << c.cellId << " AWAKE at "
+                   << c.cfgPowerDbm << " dBm (wake #" << c.wakes << ")");
+}
+
+static void NsgSleepTick () {
+    double now = Simulator::Now ().GetSeconds ();
+
+    // 1) Measure. TX airtime comes from the energy model's own state clock, so
+    //    "busy" means the radio really transmitted, not that traffic was offered.
+    double servingDutySum = 0.0;
+    int servingN = 0;
+    int awakeN = 0;
+    for (NsgSleepCell &c : g_nsgSleepCells) {
+        double txT = c.model ? c.model->m_tx_t.Get () : 0.0;
+        double d = (txT - c.lastTxT) / g_nsgSleepTickS;
+        c.lastTxT = txT;
+        c.duty = d < 0.0 ? 0.0 : (d > 1.0 ? 1.0 : d);
+        c.ues = c.dev ? c.dev->GetUeMap ().size () : 0;
+        if (c.asleep || c.waking) continue;
+        awakeN++;
+        // Only cells actually carrying UEs count as "load". An empty cell still
+        // transmits its broadcast (~7% duty here), and averaging that in would
+        // hide a saturated neighbour behind idle ones.
+        if (c.ues > 0) { servingDutySum += c.duty; servingN++; }
+    }
+    double servingDutyPct = servingN > 0 ? (servingDutySum / servingN) * 100.0 : 0.0;
+
+    // 2) Decide, per cell.
+    for (size_t i = 0; i < g_nsgSleepCells.size (); ++i) {
+        NsgSleepCell &c = g_nsgSleepCells[i];
+        // depth 0 = lever off for this cell; power 0 = the config switched the
+        // cell off entirely, which is a different (much slower) state than sleep.
+        if (c.cfg.depth <= 0 || c.cfgPowerDbm <= 0 || c.waking) continue;
+
+        if (!c.asleep) {
+            bool idle = (c.ues == 0) ||
+                        (g_nsgIdleDutyPct > 0.0 && c.duty * 100.0 < g_nsgIdleDutyPct);
+            if (!idle || now < c.awakeUntilS) { c.idleSinceS = -1.0; continue; }
+            if (c.idleSinceS < 0.0) { c.idleSinceS = now; continue; }
+            if ((now - c.idleSinceS) * 1000.0 < c.cfg.idleMs) continue;
+            // Coverage floor: never put the last mmWave cell down. UEs cannot
+            // attach to a sleeping cell, so an all-asleep layer could never be
+            // woken by demand again — a blackout the controller can't leave.
+            if (awakeN <= 1) continue;
+            c.dev->SetSleepStateCode (4 + c.cfg.depth);
+            c.dev->GetPhy ()->SetTxPower (0);
+            c.dev->GetPhy ()->SetNoiseFigure (100);
+            c.asleep = true;
+            c.sleepStartS = now;
+            c.idleSinceS = -1.0;
+            c.sleeps++;
+            NS_LOG_UNCOND ("[NSG-SLEEP] t=" << now << " cell=" << c.cellId << " -> "
+                           << NsgSleepName (c.cfg.depth) << " sleep (idle "
+                           << c.cfg.idleMs << " ms, ues=" << c.ues << ", duty="
+                           << c.duty * 100.0 << "%)");
+        } else if (servingN > 0 && servingDutyPct >= g_nsgWakeLoadPct) {
+            // Wake on demand: the cells carrying the load are running hot, so
+            // this one is needed again — and it costs its wake-up latency.
+            c.waking = true;
+            NS_LOG_UNCOND ("[NSG-SLEEP] t=" << now << " cell=" << c.cellId << " WAKING (serving-cell duty "
+                           << servingDutyPct << "% >= " << g_nsgWakeLoadPct << "%, +"
+                           << c.cfg.wakeMs << " ms)");
+            Simulator::Schedule (Seconds (c.cfg.wakeMs / 1000.0), &NsgSleepWakeDone, i);
+            break; // one cell per tick — wake gradually, not all at once
+        }
+    }
+    Simulator::Schedule (Seconds (g_nsgSleepTickS), &NsgSleepTick);
+}
+
+// Periodic (NOT end-of-run): the batch orchestrator kills ns-3 long before it
+// reaches --simTime, so an at-exit summary would never be printed. The parsers
+// take the last line per cell. The cadence has to be well under one simulated
+// second — a batch run only advances ~0.5 s of sim time in its whole wall-clock
+// window, so a 1 s summary never printed at all.
+// Matches the energy print cadence, so the last summary and the last energy
+// sample describe the same instant.
+#define NSG_SLEEP_SUMMARY_S 0.1
+static void NsgSleepSummary () {
+    double now = Simulator::Now ().GetSeconds ();
+    for (NsgSleepCell &c : g_nsgSleepCells) {
+        double slept = c.sleepTotalS + (c.asleep ? now - c.sleepStartS : 0.0);
+        NS_LOG_UNCOND ("[NSG-SLEEP-SUM] t=" << now << " cell=" << c.cellId
+                       << " depth=" << NsgSleepName (c.cfg.depth)
+                       << " state=" << (c.waking ? "waking" : (c.asleep ? "asleep" : "awake"))
+                       << " sleeps=" << c.sleeps << " wakes=" << c.wakes
+                       << " sleep_s=" << slept
+                       << " sleep_pct=" << (now > 0.0 ? 100.0 * slept / now : 0.0)
+                       << " duty_pct=" << c.duty * 100.0 << " ues=" << c.ues
+                       << " micro_s=" << (c.model ? c.model->GetStateTime (5) : 0.0)
+                       << " light_s=" << (c.model ? c.model->GetStateTime (6) : 0.0)
+                       << " deep_s=" << (c.model ? c.model->GetStateTime (7) : 0.0)
+                       << " off_s=" << (c.model ? c.model->GetStateTime (4) : 0.0)
+                       << " j=" << (c.model ? c.model->GetTotalEnergyConsumption () : 0.0));
+    }
+    Simulator::Schedule (Seconds (NSG_SLEEP_SUMMARY_S), &NsgSleepSummary);
+}
+
+// Bind the controller to the devices + energy models. Called after both exist.
+// ── NSG item 4: anomaly injection ────────────────────────────────────────────
+//
+// A test bench is only half a test bench if every cell behaves. These are the
+// faults an operator actually rehearses against, injected into the RUNNING
+// simulation rather than edited into the results afterwards.
+//
+// What is deliberately NOT here: a PCI conflict. In this engine the cell id IS
+// the RRC's map key — two cells sharing one would collide in the simulator's
+// own bookkeeping (misrouted X2, a broken cell->device lookup) rather than
+// reproduce the real symptom, which is a UE unable to tell two cells apart on
+// the air interface. Faking it would produce a crash that looks like a finding.
+//
+// Also NOT here: an RRC connection reject. Every UE in this scenario attaches at
+// t=0 and never re-attaches, so refusing new connections mid-run would be a
+// switch with nothing behind it — an inert lever, which is worse than a missing
+// one because the UI would promise it.
+struct NsgFault { uint32_t cell; double startS; double durS; int type; double value; };
+// type 0 = degrade to `value` dBm
+// type 1 = full outage (0 dBm)
+// type 2 = noise rise: +`value` dB on the cell's receiver noise figure. This is
+//          the fault a power drop CANNOT express: RSRP stays where it is and
+//          only SINR/quality falls, which is what interference and a broken LNA
+//          actually look like. Same actuator the RU sleep path already uses
+//          (SetNoiseFigure), so it is known to reach the radio.
+// type 3 = handover block: the anchor RRC refuses handover admission for the
+//          window. Cell-independent (one LTE anchor decides for every mmWave
+//          cell — see nLteEnbNodes = 1), so `cell` is ignored. The point is to
+//          test the RIC's control loop FAILING: the xApp asks for a handover
+//          and the network says no.
+
+static std::vector<std::pair<Ptr<MmWaveEnbNetDevice>, double>> g_nsgFaultRestore;
+// Baseline receiver noise figure per cell, captured alongside the power so a
+// noise fault restores to what the run was configured with rather than to the
+// 5 dB literal the sleep path assumes.
+static std::vector<double> g_nsgFaultNoiseBase;
+// The single LTE anchor whose RRC admits (or refuses) every handover.
+static Ptr<LteEnbNetDevice> g_nsgAnchorDev;
+
+static void NsgFaultApply (uint32_t idx, double toDbm, bool restore) {
+    if (idx >= g_nsgFaultRestore.size ()) return;
+    Ptr<MmWaveEnbNetDevice> dev = g_nsgFaultRestore[idx].first;
+    if (!dev || !dev->GetPhy ()) return;
+    double v = restore ? g_nsgFaultRestore[idx].second : toDbm;
+    dev->GetPhy ()->SetTxPower (v);
+    NS_LOG_UNCOND ("[NSG-FAULT] t=" << Simulator::Now ().GetSeconds () << "s cell="
+                   << dev->GetCellId () << (restore ? " RECOVERED to " : " degraded to ")
+                   << v << " dBm");
+}
+
+// type 2 — noise rise. The cell keeps transmitting at full power (RSRP is
+// untouched); what degrades is what it can hear and how clean the link looks.
+static void NsgFaultNoise (uint32_t idx, double addDb, bool restore) {
+    if (idx >= g_nsgFaultRestore.size () || idx >= g_nsgFaultNoiseBase.size ()) return;
+    Ptr<MmWaveEnbNetDevice> dev = g_nsgFaultRestore[idx].first;
+    if (!dev || !dev->GetPhy ()) return;
+    double base = g_nsgFaultNoiseBase[idx];
+    double v = restore ? base : base + addDb;
+    dev->GetPhy ()->SetNoiseFigure (v);
+    NS_LOG_UNCOND ("[NSG-FAULT] t=" << Simulator::Now ().GetSeconds () << "s cell="
+                   << dev->GetCellId () << (restore ? " noise RESTORED to " : " noise RAISED to ")
+                   << v << " dB");
+}
+
+// type 3 — handover block, on the anchor RRC that decides for every cell.
+static void NsgFaultHoBlock (bool blocked) {
+    if (!g_nsgAnchorDev) return;
+    Ptr<LteEnbRrc> rrc = g_nsgAnchorDev->GetRrc ();
+    if (!rrc) return;
+    rrc->SetAttribute ("AdmitHandoverRequest", BooleanValue (!blocked));
+    NS_LOG_UNCOND ("[NSG-FAULT] t=" << Simulator::Now ().GetSeconds ()
+                   << "s handover admission " << (blocked ? "BLOCKED" : "restored"));
+}
+
+static std::vector<NsgFault> NsgParseFaults (const std::string &s) {
+    std::vector<NsgFault> out;
+    std::stringstream ss (s);
+    std::string item;
+    while (std::getline (ss, item, ';')) {
+        if (item.find_first_not_of (" \t\r\n") == std::string::npos) continue;
+        std::stringstream is (item);
+        std::string f;
+        std::vector<double> v;
+        while (std::getline (is, f, ',')) {
+            try { v.push_back (std::stod (f)); } catch (...) { v.push_back (std::nan ("")); }
+        }
+        if (v.size () < 4) continue;
+        NsgFault t;
+        t.cell = (uint32_t) std::max (0.0, v[0]);
+        t.startS = std::max (0.0, v[1]);
+        t.durS = std::max (0.0, v[2]);
+        t.type = (int) v[3];
+        t.value = v.size () >= 5 && std::isfinite (v[4]) ? v[4] : 0.0;
+        if (t.type == 1) t.value = 0.0;          // outage is a degradation to nothing
+        // A noise fault with no magnitude would schedule a no-op and log as if
+        // something happened; 20 dB is the mildest rise anyone would call a fault.
+        if (t.type == 2 && !(t.value > 0.0)) t.value = 20.0;
+        out.push_back (t);
+    }
+    return out;
+}
+
+static void NsgFaultsInit (const NetDeviceContainer &devs,
+                           const std::vector<NsgFault> &faults) {
+    g_nsgFaultRestore.clear ();
+    g_nsgFaultNoiseBase.clear ();
+    for (uint32_t i = 0; i < devs.GetN (); ++i) {
+        Ptr<MmWaveEnbNetDevice> dev = devs.Get (i)->GetObject<MmWaveEnbNetDevice> ();
+        g_nsgFaultRestore.push_back (
+            std::make_pair (dev, dev && dev->GetPhy () ? dev->GetPhy ()->GetTxPower () : 0.0));
+        g_nsgFaultNoiseBase.push_back (
+            dev && dev->GetPhy () ? dev->GetPhy ()->GetNoiseFigure () : 5.0);
+    }
+    for (size_t k = 0; k < faults.size (); ++k) {
+        const NsgFault &t = faults[k];
+        // A handover block belongs to the anchor RRC, not to a cell, so it is
+        // scheduled before the per-cell bounds check below.
+        if (t.type == 3) {
+            if (!g_nsgAnchorDev) {
+                NS_LOG_UNCOND ("[NSG-FAULT] ignoring handover block: no anchor device");
+                continue;
+            }
+            Simulator::Schedule (Seconds (t.startS), &NsgFaultHoBlock, true);
+            if (t.durS > 0.0) {
+                Simulator::Schedule (Seconds (t.startS + t.durS), &NsgFaultHoBlock, false);
+            }
+            NS_LOG_UNCOND ("[NSG-FAULT] scheduled: HANDOVER BLOCK at t=" << t.startS
+                           << "s for "
+                           << (t.durS > 0.0 ? std::to_string (t.durS) + "s"
+                                            : "the rest of the run"));
+            continue;
+        }
+        if (t.cell >= devs.GetN ()) {
+            NS_LOG_UNCOND ("[NSG-FAULT] ignoring fault on cell " << t.cell
+                           << ": only " << devs.GetN () << " cell(s) exist");
+            continue;
+        }
+        if (t.type == 2) {
+            Simulator::Schedule (Seconds (t.startS), &NsgFaultNoise, t.cell, t.value, false);
+            if (t.durS > 0.0) {
+                Simulator::Schedule (Seconds (t.startS + t.durS), &NsgFaultNoise,
+                                     t.cell, 0.0, true);
+            }
+            NS_LOG_UNCOND ("[NSG-FAULT] scheduled: cell=" << t.cell << " at t=" << t.startS
+                           << "s NOISE RISE +" << t.value << " dB for "
+                           << (t.durS > 0.0 ? std::to_string (t.durS) + "s"
+                                            : "the rest of the run"));
+            continue;
+        }
+        Simulator::Schedule (Seconds (t.startS), &NsgFaultApply, t.cell, t.value, false);
+        // durS 0 means "for the rest of the run" — a cell that never comes
+        // back is a legitimate scenario, not a missing field.
+        if (t.durS > 0.0) {
+            Simulator::Schedule (Seconds (t.startS + t.durS), &NsgFaultApply,
+                                 t.cell, 0.0, true);
+        }
+        NS_LOG_UNCOND ("[NSG-FAULT] scheduled: cell=" << t.cell << " at t=" << t.startS
+                       << "s " << (t.type == 1 ? "OUTAGE" : "degrade")
+                       << " to " << t.value << " dBm for "
+                       << (t.durS > 0.0 ? std::to_string (t.durS) + "s" : "the rest of the run"));
+    }
+}
+
+static void NsgSleepInit (const NetDeviceContainer &devs,
+                          const energy::DeviceEnergyModelContainer &models,
+                          const std::vector<NsgSleepCfg> &specs) {
+    if (specs.empty ()) return;
+    int managed = 0;
+    for (uint32_t i = 0; i < devs.GetN (); ++i) {
+        Ptr<MmWaveEnbNetDevice> dev = devs.Get (i)->GetObject<MmWaveEnbNetDevice> ();
+        if (!dev || !dev->GetPhy ()) continue;
+        NsgSleepCell c;
+        c.dev = dev;
+        c.model = i < models.GetN ()
+                      ? DynamicCast<MmWaveRadioEnergyModelEnb> (models.Get (i))
+                      : nullptr;
+        c.cfg = specs[i < specs.size () ? i : specs.size () - 1];
+        c.cfgPowerDbm = dev->GetPhy ()->GetTxPower ();
+        c.cellId = dev->GetCellId ();
+        c.lastTxT = c.model ? c.model->m_tx_t.Get () : 0.0;
+        g_nsgSleepCells.push_back (c);
+        if (c.cfg.depth > 0 && c.cfgPowerDbm > 0) managed++;
+        NS_LOG_UNCOND ("[NSG-SLEEP] cell=" << c.cellId << " profile=" << NsgSleepName (c.cfg.depth)
+                       << " idle=" << c.cfg.idleMs << "ms wake=" << c.cfg.wakeMs
+                       << "ms power=" << c.cfgPowerDbm << "dBm"
+                       << (c.cfgPowerDbm <= 0 ? " (config-off, not sleep-managed)" : ""));
+    }
+    if (managed > 0) {
+        Simulator::Schedule (Seconds (g_nsgSleepTickS), &NsgSleepTick);
+        Simulator::Schedule (Seconds (NSG_SLEEP_SUMMARY_S), &NsgSleepSummary);
+        NS_LOG_UNCOND ("[NSG-SLEEP] controller armed for " << managed << " cell(s), tick "
+                       << g_nsgSleepTickS * 1000.0 << " ms, wake at " << g_nsgWakeLoadPct
+                       << "% awake-cell duty");
+    }
+}
