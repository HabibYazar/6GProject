+// NSG: administratively enable or disable a secondary (mmWave) cell.
+//
+// LteEnbRrc has had SetSecondaryCellHandoverAllowedStatus and
+// EvictUsersFromSecondaryCell all along, and nothing in the tree ever called
+// either. That is why "cell off" did not turn a cell off: the RIC control path
+// only dropped transmit power and raised the noise figure, so the cell stayed a
+// valid handover target, kept its users, and went on carrying tens of Mbps —
+// while reporting itself as switched off.
+//
+// Disabling therefore has to do two things in order: bar the cell as a target
+// (or the users evicted below immediately come back), then evict them. Enabling
+// only has to lift the bar; UEs return through the normal measurement path.
+//
+// The anchor is the LTE eNB: it owns the per-UE per-cell SINR map and decides
+// every secondary-cell handover. E2 control arrives at an mmWave device, which
+// is why the anchor is reached through NodeContainerManager.
+static void
+NsgSetCellEnabled (uint16_t cellId, bool enabled)
+{
+  NodeContainer &lteNodes = NodeContainerManager::GetInstance ().GetLteEnbNodes ();
+  NS_LOG_UNCOND ("[NSG] cell " << cellId << " -> " << (enabled ? "enable" : "disable")
+                               << ", anchors registered: " << lteNodes.GetN ());
+  for (uint32_t i = 0; i < lteNodes.GetN (); i++)
+    {
+      // Device 0 is not necessarily the LTE net device on an anchor node, so
+      // scan. Silently skipping on a failed cast is how the first attempt at
+      // this produced no log line at all and no effect — the one shape of bug
+      // that leaves nothing to read afterwards.
+      Ptr<LteEnbNetDevice> lteDev;
+      for (uint32_t d = 0; d < lteNodes.Get (i)->GetNDevices (); d++)
+        {
+          lteDev = lteNodes.Get (i)->GetDevice (d)->GetObject<LteEnbNetDevice> ();
+          if (lteDev)
+            break;
+        }
+      if (!lteDev)
+        {
+          NS_LOG_UNCOND ("[NSG] anchor " << i << " has no LteEnbNetDevice among "
+                                         << lteNodes.Get (i)->GetNDevices () << " devices");
+          continue;
+        }
+      Ptr<LteEnbRrc> rrc = lteDev->GetRrc ();
+      if (!rrc)
+        {
+          NS_LOG_UNCOND ("[NSG] anchor " << i << " has no RRC");
+          continue;
+        }
+      if (!rrc->SetSecondaryCellHandoverAllowedStatus (cellId, enabled))
+        {
+          NS_LOG_UNCOND ("[NSG] cell " << cellId << " unknown to the anchor RRC");
+          continue;
+        }
+      if (!enabled)
+        {
+          rrc->EvictUsersFromSecondaryCell ();
+        }
+      NS_LOG_UNCOND ("[NSG] cell " << cellId << (enabled ? " ENABLED" : " DISABLED")
+                                   << " (handover " << (enabled ? "allowed" : "barred")
+                                   << (enabled ? "" : ", users evicted") << ")");
+    }
+}
