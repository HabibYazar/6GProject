+EpsBearer::Qci
+NsgQciToEnum(uint8_t qci)
+{
+    // The FULL standardised 5QI set this ns-3 carries, not the 1-9 LTE subset.
+    //
+    // The values above 9 are the ones that make a 5G test bench interesting —
+    // mission-critical PTT (65-67, 69, 70), V2X (75, 79), low-latency
+    // eMBB/AR (80) and the industrial-automation classes (82-85). Each one
+    // carries its own priority, packet delay budget and error loss rate in
+    // ns-3's own QoS table, so picking one is a real change in how the bearer
+    // is treated, not a label.
+    //
+    // A one-to-one switch rather than a cast: EpsBearer's table calls
+    // NS_FATAL_ERROR on a QCI it does not know, so an unlisted value has to
+    // land on the default here instead of killing the run at the first
+    // GetPriority() call.
+    switch (qci)
+    {
+    case 1:
+        return EpsBearer::GBR_CONV_VOICE;
+    case 2:
+        return EpsBearer::GBR_CONV_VIDEO;
+    case 3:
+        return EpsBearer::GBR_GAMING;
+    case 4:
+        return EpsBearer::GBR_NON_CONV_VIDEO;
+    case 5:
+        return EpsBearer::NGBR_IMS;
+    case 6:
+        return EpsBearer::NGBR_VIDEO_TCP_OPERATOR;
+    case 7:
+        return EpsBearer::NGBR_VOICE_VIDEO_GAMING;
+    case 8:
+        return EpsBearer::NGBR_VIDEO_TCP_PREMIUM;
+    case 9:
+        return EpsBearer::NGBR_VIDEO_TCP_DEFAULT;
+    case 65:
+        return EpsBearer::GBR_MCPTT;
+    case 66:
+        return EpsBearer::GBR_NON_MCPTT;
+    case 67:
+        return EpsBearer::GBR_MC_VIDEO;
+    case 69:
+        return EpsBearer::NGBR_MC_DELAY_SENSI_SIG;
+    case 70:
+        return EpsBearer::NGBR_MC_DATA;
+    case 75:
+        return EpsBearer::GBR_V2X_MESSAGES;
+    case 79:
+        return EpsBearer::NGBR_V2X_MESSAGES;
+    case 80:
+        return EpsBearer::NGBR_LOW_LAT_EMBB_AR;
+    case 82:
+        return EpsBearer::GBR_DISC_AUTO_S_PACKETS;
+    case 83:
+        return EpsBearer::GBR_DISC_AUTO_B_PACKETS;
+    case 84:
+        return EpsBearer::GBR_INTEL_TRANSPORT_SYS;
+    case 85:
+        return EpsBearer::GBR_ELECTRIC_DIST_HV;
+    default:
+        return EpsBearer::NGBR_VIDEO_TCP_DEFAULT;
+    }
+}
+
+bool
+NsgIsKnownQci(uint8_t qci)
+{
+    // 9 is both a real 5QI and the fallback, so a round-trip is the honest
+    // test of "did the catalogue recognise this".
+    return qci == 9 || NsgQciToEnum(qci) != EpsBearer::NGBR_VIDEO_TCP_DEFAULT;
+}
+
 } // namespace ns3
