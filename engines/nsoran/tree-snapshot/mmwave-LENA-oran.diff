+double
+MmWaveRadioEnergyModelEnb::GetStateTime (int state) const
+{
+  double t = 0.0;
+  switch (state)
+    {
+    case STATE_IDLE:         t = m_idle_t.Get (); break;
+    case STATE_TX:           t = m_tx_t.Get (); break;
+    case STATE_RX_DATA:      t = m_data_t.Get (); break;
+    case STATE_RX_CTRL:      t = m_ctrl_t.Get (); break;
+    case STATE_OFF:          t = m_off_t.Get (); break;
+    case STATE_SLEEP_MICRO:  t = m_micro_sleep_t.Get (); break;
+    case STATE_SLEEP_LIGHT:  t = m_light_sleep_t.Get (); break;
+    case STATE_SLEEP_DEEP:   t = m_deep_sleep_t.Get (); break;
+    default: return 0.0;
+    }
+  if (state == m_currentState)
+    {
+      t += (Simulator::Now () - m_lastUpdateTime).GetSeconds ();
+    }
+  return t;
+}
